# Build output
build/
app/build/
*/build/
.gradle/
.kotlin/

# Local machine configuration - never commit (SDK path, and a place secrets could leak)
local.properties
local.properties.bak

# Signing material - never commit (docs/PLATFORM_MATRIX.md §5.7, docs/SECURITY.md §5)
*.keystore
*.jks
keystores/
signing.properties
*.p12
*.pfx
*.pem
*.key

# Generated / captured on device
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.log

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# The bundled proxy core binaries are third-party artefacts with a pinned hash
# (docs/CORE_APPROVAL.md). The core IS chosen (Xray-core v26.3.27) and the Android library is
# fetched on demand — `python scripts/fetch_core.py --android` — and verified against the pin
# approved, so there is nothing legitimate to commit.
app/src/main/jniLibs/*/*.so
