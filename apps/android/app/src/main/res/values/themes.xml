<?xml version="1.0" encoding="utf-8"?>
<!--
  App theme for the Smart Accelerator Android client (skeleton).

  Spec 88-90, 132. Deliberately a framework parent (`android:Theme.Material.*`) so the
  skeleton needs no XML-material-components dependency: the entire UI is Jetpack
  Compose and themes itself through ui/theme/Theme.kt (Material3).
  Not verified: no build has been run here (no Android SDK/JDK).
-->
<resources>
    <style name="Theme.Accelerator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
